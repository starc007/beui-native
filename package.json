{
  "name": "beui-native",
  "version": "0.1.0",
  "private": true,
  "description": "Animated, accessible React Native components built for touch. A native companion to beUI: Reanimated, Gesture Handler and Uniwind.",
  "keywords": [
    "react-native",
    "expo",
    "ui-components",
    "animation",
    "reanimated",
    "react-native-gesture-handler",
    "tailwindcss",
    "uniwind",
    "accessibility",
    "ios",
    "android",
    "typescript",
    "beui"
  ],
  "homepage": "https://github.com/starc007/beui-native#readme",
  "bugs": {
    "url": "https://github.com/starc007/beui-native/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/starc007/beui-native.git"
  },
  "license": "MIT",
  "author": {
    "name": "Saurabh",
    "url": "https://x.com/saurra3h"
  },
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "example"
  ],
  "scripts": {
    "dev": "bun run --cwd example start",
    "ios": "bun run --cwd example ios",
    "android": "bun run --cwd example android",
    "web": "bun run --cwd example web",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "bun run typecheck && bun run lint",
    "doctor": "cd example && bunx expo-doctor",
    "export": "bun run --cwd example export",
    "manifest": "bun scripts/manifest.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "trustedDependencies": [
    "@shopify/react-native-skia"
  ]
}
