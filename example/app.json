{
  "expo": {
    "name": "beUI Native",
    "slug": "beui-native",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.beui.showcase"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.beui.showcase"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "beui-native",
    "plugins": ["expo-router"],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "93a3a95c-6dc2-4adb-b57c-efbecf859f25"
      }
    },
    "owner": "saurrabhh",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/93a3a95c-6dc2-4adb-b57c-efbecf859f25"
    }
  }
}
